DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional: accept commands and messages only in these comma-separated channels (including for admins).
# Leave blank to allow multiple project channels. Threads must be listed by their own channel IDs.
DISCORD_CHANNEL_IDS=
ALLOWED_USER_IDS=123456789,987654321
BASE_PROJECT_DIR=/Users/you/projects
RATE_LIMIT_PER_MINUTE=10
# Compact activity summaries by default; true includes command text and output.
DISCORD_VERBOSE=false
