DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional: accept commands and messages only in this exact channel (including for admins).
# Leave blank to allow multiple project channels. Threads have their own channel IDs.
DISCORD_CHANNEL_ID=
ALLOWED_USER_IDS=123456789,987654321
BASE_PROJECT_DIR=/Users/you/projects
RATE_LIMIT_PER_MINUTE=10
# Compact activity summaries by default; true includes command text and output.
DISCORD_VERBOSE=false
